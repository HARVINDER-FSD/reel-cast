{
  "name": "reelcast-monorepo",
  "version": "1.0.0",
  "description": "India's #1 Creator, Model & Instagram Page Marketplace - Monorepo (Frontend + Backend)",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "npm run dev",
    "build": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "start:all": "concurrently \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "lint": "npm run lint --workspace=server",
    "test": "npm run test --workspace=server",
    "create:admin": "npm run --workspace=server create-admin.js",
    "create:super-admin": "npm run --workspace=server create-super-admin.js",
    "create:users": "npm run --workspace=server create-user.js"
  },
  "keywords": [
    "marketplace",
    "creators",
    "influencers",
    "instagram",
    "talent",
    "monorepo"
  ],
  "author": "ReelCast",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
