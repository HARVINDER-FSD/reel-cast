# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Local OR MongoDB Atlas)
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/reelcast

# MongoDB Atlas (Uncomment to use cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/reelcast?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie Settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=3

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900000

# Application
APP_NAME=ReelCast
SUPPORT_EMAIL=support@reelcast.com

# Admin Configuration
SUPER_ADMIN_EMAIL=superadmin@reelcast.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
ADMIN_EMAIL=admin@reelcast.com
ADMIN_PASSWORD=Admin123!
